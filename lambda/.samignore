QUICK_START.md

# Development files
.env
.env.*
.gitignore

# Test files
test/
tests/
*.test.js
*.spec.js

# Build artifacts
*.zip
lambda-deployment-*.zip

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# SAM
.aws-sam/
samconfig.toml
